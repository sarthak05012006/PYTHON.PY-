task:
Given the names and grades for each student in a class of  students,
store them in a nested list and print the name(s) of any student(s) having the second lowest grade.




if __name__ == '__main__':
    students = []
    
    # 1. Take input and store in a nested list
    for _ in range(int(input())):
        name = input()
        grade = float(input())
        students.append([name, grade])
        
    # 2. Extract unique grades and sort them to find the second lowest
    grades = sorted(set([student[1] for student in students]))
    second_lowest = grades[1]
    
    # 3. Find all students with the second lowest grade
    second_lowest_students = []
    for student in students:
        if student[1] == second_lowest:
            second_lowest_students.append(student[0])
            
    # 4. Sort the names alphabetically and print each one
    second_lowest_students.sort()
    for student_name in second_lowest_students:
        print(student_name)
